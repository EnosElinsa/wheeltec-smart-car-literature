# ---------------------------------------------------------------------------
# Admitted reading sources are delivered through Git LFS.
# Other PDFs and extraction diagnostics remain local.
# ---------------------------------------------------------------------------
*.pdf
!01-papers/T*/*/paper.pdf

# Publish the canonical full texts and reading images, not extractor internals.
02-fulltext/**
!02-fulltext/**/
!02-fulltext/INDEX.md
!02-fulltext/T*/README.md
!02-fulltext/T*/*/paper.md
!02-fulltext/T*/*/images/*.png
!02-fulltext/T*/*/images/*.jpg

# Historical archive (contains run logs, local paths, and full texts).
99-archive/*.zip
99-archive/superseded/
99-archive/local/

# Local reading view, source evidence and reusable OCR runtime data.
/06-data/provenance/
/06-data/missing-items.md
/.local/

# Self-authored manuscript outputs and figures are published with the sources.
!05-survey/manuscript/survey.pdf
!05-survey/manuscript/supplement.pdf
!05-survey/manuscript/figures/*.pdf

# Acquisition state, credentials, and temporary extraction folders.
.env
.env.*
.arp/
arp-state/
arp-deliveries/
tmp/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# LaTeX build products (in case a build runs outside the manuscript folder)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Editors and OS
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Local library apply/rollback snapshots.
/.arp-backups/
