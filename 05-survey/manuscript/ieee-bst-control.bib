% IEEEtran.bst control entry, activated by \bstctlcite{IEEEexample:BSTcontrol}.
% IEEE editorial style: list up to six authors; with more than six, list the
% first author followed by "et al."
@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLuse_forced_etal = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal = "1"
}
