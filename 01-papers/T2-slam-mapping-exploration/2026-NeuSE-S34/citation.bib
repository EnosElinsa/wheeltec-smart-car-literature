@article{doi:10.1177/02783649251355966,
author = {Jiahui Fu and Yilun Du and Kurran Singh and Joshua B Tenenbaum and John J Leonard},
title ={NeuSE: Neural SE(3)-equivariant embedding for long-term object-based simultaneous localization and mapping},

journal = {The International Journal of Robotics Research},
volume = {45},
number = {1},
pages = {159-189},
year = {2026},
doi = {10.1177/02783649251355966},

URL = { 
    
        https://doi.org/10.1177/02783649251355966
    
    

},
