

@article{annurev:/content/journals/10.1146/annurev-control-032724-020548,
   author = "Krawciw, Alexander and Barfoot, Timothy D.",
   title = "Local Maps Are All You Need: A Review of Topometric Teach and Repeat Navigation", 
   journal= "Annual Review of Control, Robotics, and Autonomous Systems",
   year = "2026",
   volume = "9",
   number = "Volume 9, 2026",
   pages = "301-324",
   doi = "https://doi.org/10.1146/annurev-control-032724-020548",
   url = "https://www.annualreviews.org/content/journals/10.1146/annurev-control-032724-020548",
   publisher = "Annual Reviews",
   issn = "2573-5144",
   type = "Journal Article",
   keywords = "topometric maps",
   keywords = "field robotics",
   keywords = "teach and repeat",
   abstract = "Teach and repeat (T&amp;R) navigation has gained popularity over the past 15 years for its reliable path tracking in global navigation satellite system (GNSS)–denied environments. By using topometric navigation, it blends the scalability of graphs to connect distant places of interest, with metric estimates of a robot&apos;s state that allow control algorithms to correct path-tracking errors. Robots have been field-tested in off-road environments and found commercial applications in mining, cleaning, and agriculture. We present a summary of the different interpretations of T&amp;R, introduce the relative strengths of various sensors in T&amp;R, highlight methods that boost the reliability of T&amp;R on robot hardware, and propose that the effectiveness of local maps in topometric navigation comes from a sensor-dependent bias–variance trade-off.",
  }

