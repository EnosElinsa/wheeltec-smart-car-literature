author = {González-Calvin, Alfredo and García-Pérez, Lía and Jiménez, Juan F.},
title = {Singularity-Free Guiding Vector Field Over Bézier's Curves Applied to Rovers Path Planning and Path Following},
journal = {Journal of Field Robotics},
volume = {42},
number = {6},
pages = {2720-2739},
keywords = {curvature-changing speed setpoint, guiding vector fields, parametric paths, path following, rover, speed controller, wheeled mobile robots},
doi = {https://doi.org/10.1002/rob.22541},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/rob.22541},
