@article{doi:10.1177/02783649251401926,
author = {Fan Yang and Per Frivik and David Hoeller and Chen Wang and Cesar Cadena and Marco Hutter},
title ={Spatially-enhanced recurrent memory for long-range mapless navigation via end-to-end reinforcement learning},

journal = {The International Journal of Robotics Research},
volume = {45},
number = {11},
pages = {1682-1706},
year = {2026},
