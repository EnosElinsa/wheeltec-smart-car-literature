author = {Shibo Zhao  and Sifan Zhou  and Yuchen Zhang  and Ji Zhang  and Chen Wang  and Wenshan Wang  and Sebastian Scherer },
title = {Resilient odometry via hierarchical adaptation},
journal = {Science Robotics},
volume = {10},
