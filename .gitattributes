# Publisher BibTeX exports must keep their original bytes (hashes are
# recorded in 06-data/paper-index.csv), so Git must not normalize them.
*.bib -text
# Raw publisher citation spacing is part of the preserved source bytes.
01-papers/**/citation.bib -whitespace
# Data tables keep their byte layout (UTF-8 BOM, line endings).
*.csv -text whitespace=cr-at-eol
*.jsonl -text
# Supplementary provenance hashes refer to the exact registered bytes.
**/provenance.json -text
# Preserve reading-source bytes and store large payloads outside normal Git blobs.
01-papers/**/paper.pdf filter=lfs diff=lfs merge=lfs -text
02-fulltext/**/paper.md filter=lfs diff=lfs merge=lfs -text
02-fulltext/**/images/*.png filter=lfs diff=lfs merge=lfs -text
02-fulltext/**/images/*.jpg filter=lfs diff=lfs merge=lfs -text
/INDEX.html -text
